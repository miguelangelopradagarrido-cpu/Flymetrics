APP_NAME=FlymetricsOS
APP_VERSION=1.0.0

# Base de Datos MySQL Local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flymetrics_db
DB_USER=root
DB_PASSWORD=miguepro

# Seguridad y Autenticación JWT
JWT_SECRET=flymetrics_super_secret_key_2025_prod_local_key_hash
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Credenciales de Administrador Inicial (Despliegue)
ADMIN_EMAIL=admin@flymetrics.co
ADMIN_PASSWORD=Admin123456!

# Configuración del Servidor
PORT=3000

# Integraciones de Terceros (Mockeados en desarrollo local)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
WHATSAPP_VERIFY_TOKEN=flymetrics_whatsapp_verification_token_local
WHATSAPP_ACCESS_TOKEN=mock_whatsapp_access_token_from_meta_developer_portal
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Almacenamiento en Nube
AWS_S3_BUCKET=flymetrics-deliverables-bucket
AWS_REGION=us-east-1

# Integración Gmail API con OAuth2 (Google Cloud)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_privado
GOOGLE_REFRESH_TOKEN=tu_refresh_token_oauth2
GOOGLE_EMAIL=jonathan.d.castro.ortiz@gmail.com
GMAIL_SENDER_NAME=Flymetrics

